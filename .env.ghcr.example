# Run the CI-published GHCR images instead of building locally.
# Both packages are public, so no `docker login` is needed to pull.
#
# Usage:
#   set -a; . ./.env.ghcr; set +a       # (copy this file to .env.ghcr first, pin a tag)
#   docker compose -f docker-compose.chiado-node.yml \
#                  -f docker-compose.driven.override.yml pull
#   docker compose -f docker-compose.chiado-node.yml \
#                  -f docker-compose.driven.override.yml up -d
#
# Production deploys should PIN an immutable `sha-<short>` tag (not `latest`):
#   EEZ_NODE_IMAGE=ghcr.io/eez-association/eez-node:sha-abc1234
#   EEZ_PROVERD_IMAGE=ghcr.io/eez-association/eez-proverd:sha-abc1234
#
# Leaving these UNSET keeps the default local-build behaviour (eez-node:local).
# The .dev.yml overlay (host-binary mount) is unaffected and ignores these.

EEZ_NODE_IMAGE=ghcr.io/eez-association/eez-node:latest
EEZ_PROVERD_IMAGE=ghcr.io/eez-association/eez-proverd:latest
EEZ_PULL_POLICY=always
