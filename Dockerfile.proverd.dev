# syntax=docker/dockerfile:1
#
# eez-proverd DEV runtime — for fast iteration WITHOUT the slow from-source
# build of eez-proverd + native-validate. Pairs with
# docker-compose.proverd.dev.yml, which volume-mounts the HOST-compiled
#   ./target/release/eez-proverd                              -> /usr/local/bin/eez-proverd
#   ../zisk-eth-client/target/release/native-validate         -> /usr/local/bin/native-validate
#
# WHY ubuntu:24.04 (not debian-slim): the prod runtime (debian:bookworm-slim,
# glibc 2.36) CANNOT run a binary compiled on this host (Ubuntu, glibc 2.39).
# This matches the host glibc so the locally-compiled binaries run unmodified
# (same rationale as Dockerfile.dev for eez-node).
#
# Build once (~15s):
#   docker compose -f docker-compose.proverd.dev.yml build eez-proverd
# Iterate:
#   cargo build --release -p eez-proverd        # (+ rebuild native-validate in the fork if needed)
#   docker compose --env-file .env.chiado -f docker-compose.proverd.dev.yml up -d --force-recreate eez-proverd
FROM ubuntu:24.04 AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*
# L2 chain-config baked; the binaries arrive via the compose volume mounts
# (intentionally NOT COPYed here).
COPY configs/l2-chainconfig.json /app/l2-chainconfig.json
ENTRYPOINT ["eez-proverd"]
CMD ["--help"]
