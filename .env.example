# eez-rollup0 environment configuration.
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# Two-file split:
#   - `.env`             : YOU fill in (keys, RPC, datadir).
#   - `deployments.env`  : `scripts/deploy.sh` writes this with contract
#                          addresses + rollupId + deploy block. Gitignored.
#                          eez-node auto-loads both on startup via dotenvy.

# ─── L1 connection ─────────────────────────────────────────────────────────
# Required. RPC endpoint for the L1 chain where postBatch lands.
# Example: chiado devnet at the team RPC.
EEZ_L1_RPC_URL=http://37.27.238.19:18545

# Required. The L1 EOA private key. Used to:
#   - pay gas for `make deploy-protocol` (becomes Rollup manager owner)
#   - pay gas for postBatch txs at runtime
EEZ_L1_POSTER_KEY=0x...

# Required. The key whose ECDSA signature stage-2 proofs are. Its address
# gets baked into `MockECDSAProofSystem` as the `authorizedSigner` at
# deploy time. On a devnet this can be the SAME value as
# EEZ_L1_POSTER_KEY; in production they're separate. A real prover
# replaces this with whatever the proof system needs.
EEZ_PROOF_SIGNER_KEY=0x...

# Optional. Initial L2 state root the rollup is registered with.
# Defaults to reth `--chain dev`'s genesis state root. Pin a different
# value if you're registering against a different L2 genesis.
# EEZ_INITIAL_STATE_ROOT=0xf09d8f7da5bc5036f8dd9536c953e2212390a46fb3e553ece2b7d419131537b1

# Optional. Blockscout base URL for the L1 chain. If set,
# `scripts/deploy.sh` runs `forge verify-contract` against this
# endpoint for every freshly-created contract after the 4-step deploy.
# Best-effort — verify failures are logged but don't fail the deploy.
# Requires `jq`. The script appends `/api/` to this base URL.
# Pre-filled with the public chiado L1 Blockscout to match the default
# `EEZ_L1_RPC_URL` above. Blank it out to skip verification.
EEZ_BLOCKSCOUT_URL=https://gnosis-chiado.blockscout.com

# ─── Composer ─────────────────────────────────────────────────────────────
# Optional. How often the Composer task ticks. Each tick checks for a
# pending batch and submits at most one. Default: 60s.
EEZ_COMPOSER_INTERVAL_SECS=60

# ─── L2 (sequencer) ───────────────────────────────────────────────────────
# Required. Datadir for the local L2 reth. Recommended: a path OUTSIDE
# the repo so `cargo clean` and `git status` don't trip over chain data.
EEZ_L2_DATADIR=/tmp/eez-rollup0-data

# ─── Auto-populated by `make deploy-protocol` ────────────────────────────
# Do NOT set these by hand — `scripts/deploy.sh` writes them to
# `deployments.env`. They're listed here for documentation.
#
# EEZ_REGISTRY_ADDRESS=0x...
# EEZ_REGISTRY_DEPLOY_BLOCK=12345
# EEZ_MOCK_PROOF_SYSTEM_ADDRESS=0x...
# EEZ_ROLLUP_MANAGER_ADDRESS=0x...
# EEZ_ROLLUP_ID=1
