# Secret inputs for running the signer locally. The service also needs
# `EEZ_CHAIN_CONFIG` plus the public deployment bindings generated in
# `deployments.env`: `EEZ_ROLLUP_ID`, `EEZ_VKEY`, `EEZ_PROOF_SYSTEM`, and
# `EEZ_ATTESTER_ADDRESS`, and `EEZ_L2_SYSTEM_ADDRESS`.
# Never commit real private keys.
EEZ_PROOF_SIGNER_KEY=<64-hex-character-attestation-private-key>
EEZ_L2_SYSTEM_KEY=<64-hex-character-l2-system-private-key>

# Optional request-limit / timeout overrides (defaults shown). Raise
# EEZ_PROOF_SIGNER_MAX_REQUEST_BLOCKS to match the composer's
# EEZ_MAX_BLOCKS_PER_BATCH — a batch above this window is rejected outright.
# EEZ_PROOF_SIGNER_MAX_REQUEST_BLOCKS=512
# EEZ_PROOF_SIGNER_MAX_REQUEST_BYTES=536870912
# EEZ_PROOF_SIGNER_MAX_REQUEST_WITNESS_ITEMS=1000000
# EEZ_PROOF_SIGNER_MAX_TRANSACTION_STATE_CHECKPOINTS=8
# EEZ_PROOF_SIGNER_STREAM_IDLE_TIMEOUT_SECS=120
# EEZ_PROOF_SIGNER_REQUEST_TIMEOUT_SECS=600
