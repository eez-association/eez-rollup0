# Copy to infra/kurtosis/.env (gitignored). Set keys from Kurtosis prefunded accounts.
#
# RPC URLs below are PLACEHOLDERS. Kurtosis assigns ports dynamically, so the
# actual EL / builder ports usually differ (e.g. 32003 / 32033). ALWAYS run
# parse-endpoints.sh after kurtosis-up — it writes the real URLs to
# endpoints.env, which every script sources on top of this file. Do not rely
# on these defaults matching your enclave.

EEZ_L1_EMBEDDED=0
EEZ_L1_RPC_URL=http://127.0.0.1:32000          # el-1 reth JSON-RPC ("rpc" 8545), EL range
EEZ_L1_BUILDER_RPC_URL=http://127.0.0.1:32000  # rbuilder "rbuilder-rpc" (8645) — EL range, NOT mev/37000
EEZ_L1_TARGET_RPC_URL=http://127.0.0.1:32000   # tip oracle; same node as EEZ_L1_RPC_URL is fine

# Poster pays L1 gas; proof signer authorizes batches. Use prefunded
# ethereum-package mnemonic accounts at UNUSED indices (e.g. 1, 2, 4, 5) —
# avoid 0 (builder coinbase), 3 (tx_fuzz), 12 (deployer), 13 (spamoor).
EEZ_L1_POSTER_KEY=0xCHANGE_ME
EEZ_PROOF_SIGNER_KEY=0xCHANGE_ME

EEZ_L1_BLOCK_TIME_MS=12000
EEZ_L2_BLOCK_TIME_MS=2000
EEZ_PROOF_TIME_MS=4000
EEZ_SUBMISSION_SLACK_MS=1500

EEZ_L2_DATADIR=/tmp/eez-kurtosis-l2
EEZ_L2_GENESIS_PATH=./datadir/genesis.json
EEZ_L2_HTTP_PORT=18688
EEZ_L2_AUTH_PORT=18684
EEZ_L2_P2P_PORT=30640

EEZ_L2_SYSTEM_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
EEZ_L2_SYSTEM_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
EEZ_CCM_L2_ADDRESS=0x4200000000000000000000000000000000000007
