# Copy to infra/kurtosis/.env (gitignored) for the UNIFIED harness — eez-node
# with its EMBEDDED L1 (Pair A) peered into the Kurtosis enclave (Pair B).
#
# This is the cross-chain variant. For settlement-only (L1 fully external,
# EEZ_L1_EMBEDDED=0), use eez.env.example instead.
#
# RPC URLs are PLACEHOLDERS. Kurtosis assigns ports dynamically:
#   - parse-endpoints.sh writes endpoints.env with the real Kurtosis EL RPC and
#     the rbuilder-rpc (EEZ_L1_BUILDER_RPC_URL) — every script sources it on top.
#   - run-eez-embedded.sh then PINS EEZ_L1_RPC_URL / EEZ_L1_TARGET_RPC_URL to
#     eez-node's OWN embedded reth (127.0.0.1:18545) and keeps the rbuilder URL
#     from endpoints.env. So the only Kurtosis-derived value you rely on here is
#     the builder RPC, and it comes from endpoints.env automatically.

# ── Embedded L1 (Pair A) ─────────────────────────────────────────────
EEZ_L1_EMBEDDED=1
EEZ_L1_CHAIN=devnet
EEZ_L1_HTTP_PORT=18545        # embedded reth JSON-RPC (cast, deploy fallback)
# Engine API the follower beacon dials. MUST be 18551, not 18546: reth binds
# its WS server on http_port+1 (=18546), so 18546 collides and a bind fails.
EEZ_L1_AUTH_PORT=18551
# Filled by extract-genesis.sh (paths resolved to absolute by run-eez-embedded.sh):
EEZ_L1_CHAIN_PATH=./infra/kurtosis/eez-l1-data/genesis.json
EEZ_L1_JWT_SECRET=./infra/kurtosis/eez-l1-data/jwt/jwtsecret
# MUST match the Kurtosis genesis chainId (network_params.yaml network_id=7331).
EEZ_L1_CHAIN_ID=7331

# eez-node dials its OWN embedded L1 (run-eez-embedded.sh pins these; shown for
# clarity). REQUIRED — Mode::from_env() gates composer mode on EEZ_L1_RPC_URL.
EEZ_L1_RPC_URL=http://127.0.0.1:18545
EEZ_L1_TARGET_RPC_URL=http://127.0.0.1:18545
# Bundle target: the Kurtosis rbuilder. Left as a placeholder — endpoints.env
# (from parse-endpoints.sh) overrides it with the real rbuilder-rpc port.
EEZ_L1_BUILDER_RPC_URL=http://127.0.0.1:32000

# ── EEZ keys ─────────────────────────────────────────────────────────
# Poster pays L1 gas; proof signer authorizes batches. Use prefunded
# ethereum-package mnemonic accounts at UNUSED indices (e.g. 1, 2, 4, 5) —
# avoid 0 (builder coinbase), 3 (tx_fuzz), 12 (deployer), 13 (spamoor).
EEZ_L1_POSTER_KEY=0xCHANGE_ME
EEZ_PROOF_SIGNER_KEY=0xCHANGE_ME

# ── Timing (matches mainnet() profile + the Kurtosis devnet) ─────────
EEZ_L1_BLOCK_TIME_MS=12000
EEZ_L2_BLOCK_TIME_MS=2000
EEZ_PROOF_TIME_MS=4000
EEZ_SUBMISSION_SLACK_MS=1500

# Fee recipient for the follower beacon's payload attributes (optional).
DEVNET_FEE_RECIPIENT=0x0000000000000000000000000000000000000000

# ── L2 (eez-node's own rollup reth) ──────────────────────────────────
EEZ_L2_DATADIR=/tmp/eez-unified-l2
EEZ_L2_GENESIS_PATH=./datadir/genesis.json
EEZ_L2_HTTP_PORT=18688
EEZ_L2_AUTH_PORT=18684
EEZ_L2_P2P_PORT=30640

EEZ_L2_SYSTEM_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
EEZ_L2_SYSTEM_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
EEZ_CCM_L2_ADDRESS=0x4200000000000000000000000000000000000007
