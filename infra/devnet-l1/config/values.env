# ethereum-genesis-generator inputs for the EEZ private PoS L1 devnet.
# Consumed by scripts/gen-genesis.sh. These values MUST stay in sync with
# what eez-node loads: CHAIN_ID here == the `chainId` in the generated
# genesis.json that eez-node reads via EEZ_L1_CHAIN_PATH.
#
# Pin the generator image tag in gen-genesis.sh for reproducible genesis.

# Private network id. Matches network_params.yaml (7331) so this devnet is
# interchangeable with the Kurtosis one in Phase 3.
export CHAIN_ID=7331

# Post-merge from genesis: TTD=0, all forks active at genesis so the CL
# drives block production immediately (no PoW ramp, no fork transitions to
# babysit on a throwaway devnet). Deneb + Electra at epoch 0.
export DENEB_FORK_EPOCH=0
export ELECTRA_FORK_EPOCH=0

# Seconds per slot. 12s to match mainnet timing + the Kurtosis devnet, so
# EEZ's L1/L2 timing profile (EEZ_L1_BLOCK_TIME_MS=12000) is identical
# across both harnesses.
export SECONDS_PER_SLOT=12
export SLOT_DURATION_IN_SECONDS=12

# Genesis validators. 64 is enough for stable finality on a single-machine
# devnet while keeping validator-client startup fast. All keys derive from
# the mnemonic below and are written to ./data/validator-keys.
export NUMBER_OF_VALIDATORS=64

# Delay (s) between running the generator and genesis time. Give the CL/EL
# containers time to come up before slot 0 so they don't start already
# behind. Bump if your host is slow to pull images.
export GENESIS_DELAY=60

# Base genesis timestamp. MUST be wall-clock now, not 0 — the generator
# computes genesis_time = GENESIS_TIMESTAMP + GENESIS_DELAY, so leaving this
# unset makes genesis land at 1970 (genesis_time=60) and the CL jumps to slot
# ~148,000,000. Evaluated fresh at generation time (values.env is sourced by
# the generator container, which has `date`). Regenerate genesis to re-stamp.
export GENESIS_TIMESTAMP=$(date +%s)

# Deterministic mnemonics (devnet only — NEVER reuse on anything real).
# One mnemonic seeds the validator set; the other prefunds EL EOAs.
export EL_AND_CL_MNEMONIC="giant issue aisle success illegal bike spike question tent bar rely arctic volcano long crawl hungry vocal artwork sniff fantasy very lucky have athlete"

# Standard devnet deposit contract address (matches ethpandaops defaults so
# the generated CL config and EL genesis agree).
export DEPOSIT_CONTRACT_ADDRESS=0x4242424242424242424242424242424242424242

# Prefunded EL accounts. Index 0 of the mnemonic is the deployer/faucet.
# Add the EEZ poster + proof-signer addresses here (or fund them from the
# faucet after genesis). Balance in wei-hex is set by the generator's
# genesis template; the mnemonic-derived accounts are prefunded by default.
