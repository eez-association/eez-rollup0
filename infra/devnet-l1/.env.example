# Copy to infra/devnet-l1/.env and adjust. Sourced by run-devnet-l1.sh and
# passed to docker compose (--env-file .env).
#
# Paths below are relative to infra/devnet-l1/ (where docker-compose.cl.yml
# lives). Do NOT prefix with infra/devnet-l1/ again — that makes compose mount
# an empty infra/devnet-l1/infra/devnet-l1/data tree.

# ── Paths (relative to infra/devnet-l1/, or use absolute paths) ───────
DEVNET_DATA_DIR=./data
DEVNET_JWT_FILE=./data/jwt/jwtsecret
EEZ_L1_CHAIN_PATH=./data/metadata/genesis.json
# Embedded L1 reth datadir (wipe when you regenerate genesis).
EEZ_L1_DATADIR=/tmp/eez-devnet-l1
# L2 reth datadir.
EEZ_L2_DATADIR=/tmp/eez-devnet-l2

# ── Embedded L1 (eez-node) ───────────────────────────────────────────
EEZ_L1_EMBEDDED=1
EEZ_L1_CHAIN=devnet
EEZ_L1_HTTP_PORT=18545       # EL JSON-RPC (cast, deploy)
# Engine API (lighthouse dials this). MUST NOT equal EEZ_L1_HTTP_PORT+1:
# reth binds its WS server on http_port+1 (=18546), so an auth port of 18546
# collides with WS and one bind fails at startup. 18551 is reth's conventional
# engine port and is clear of the WS port.
EEZ_L1_AUTH_PORT=18551       # engine API (lighthouse dials this)
EEZ_L1_P2P_PORT=30444
EEZ_L1_JWT_SECRET=./data/jwt/jwtsecret

# ── L1 RPC (self-referential: eez-node dials its OWN embedded L1) ────
# REQUIRED. Mode::from_env() gates composer mode on this var being set at
# all — without it eez-node silently runs Standalone (no embedded L1, no
# composer) instead of failing loud. Must match EEZ_L1_HTTP_PORT above.
EEZ_L1_RPC_URL=http://127.0.0.1:18545
# Optional tip-follower override for BundleTarget::NextBlock target-block
# picking (see eez-l1::SubmitterConfig). Same node is fine here — the
# embedded L1 IS the tip on this devnet (no separate followers).
EEZ_L1_TARGET_RPC_URL=http://127.0.0.1:18545
# REQUIRED for EIP-155 signing of the postBatch tx. MUST match
# config/values.env's CHAIN_ID (7331) — this is NOT reth's dev chainId
# (1337, main.rs's fallback default), and a mismatch signs postBatch for
# the wrong chain (silently rejected or worse).
EEZ_L1_CHAIN_ID=7331

# ── EEZ keys (fund from the mnemonic faucet / prefunded accounts) ─────
EEZ_L1_POSTER_KEY=0xCHANGE_ME
EEZ_PROOF_SIGNER_KEY=0xCHANGE_ME
EEZ_L2_SYSTEM_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
EEZ_L2_SYSTEM_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
EEZ_CCM_L2_ADDRESS=0x4200000000000000000000000000000000000007

# ── Protocol deployment (written by scripts/deploy-eez.sh; do not set by
# hand — placeholders here only so a syntax-checking `source` doesn't
# choke before the bootstrap step runs). Real values land in
# infra/devnet-l1/deployments.env, sourced separately by run-devnet-l1.sh.
# EEZ_REGISTRY_ADDRESS=
# EEZ_MOCK_PROOF_SYSTEM_ADDRESS=
# EEZ_ROLLUP_ID=
# EEZ_REGISTRY_DEPLOY_BLOCK=

# ── Timing (matches mainnet() profile + Kurtosis devnet) ─────────────
EEZ_L1_BLOCK_TIME_MS=12000
EEZ_L2_BLOCK_TIME_MS=2000
EEZ_PROOF_TIME_MS=4000
EEZ_SUBMISSION_SLACK_MS=1500

# Fee recipient for CL-produced L1 payloads (optional).
DEVNET_FEE_RECIPIENT=0x0000000000000000000000000000000000000000

# ── Builder RPC ──────────────────────────────────────────────────────
# This harness has NO rbuilder — leave this at the EL RPC; the Submitter
# degrades to ordered mempool submission (fine for proving CL-driven blocks +
# EvmComposer cross-chain). For cross-chain WITH a real rbuilder + relay + MEV,
# use the unified Kurtosis harness instead (infra/kurtosis/, "Unified harness"
# in its README) — it reuses Kurtosis's flashbots stack rather than standing up
# a bespoke one here.
EEZ_L1_BUILDER_RPC_URL=http://127.0.0.1:18545
