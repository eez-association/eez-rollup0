# Second competing composer on the SAME machine. Copy to .env.chiado-2, fill in
# the DISTINCT funded poster key, then launch (see docker-compose.chiado-node-2.override.yml).
#
# JOINS the already-deployed rollup (deployments.env, unchanged). SHARES the
# contracts + genesis + proof signer with the first composer; DIFFERS in: its own
# funded poster EOA, its own data volumes, and its own port set (the -2 override).

# ── Host paths — DISTINCT volumes (must not share the 1st's mdbx) ─────
# Own chiado L1 snapshot — populate ONCE (own-L1 variant only):
#   docker run --rm -v "$PWD/data/chiado-l1-2:/data" \
#     ghcr.io/gnosischain/reth_gnosis:v2.0.0 download --chain chiado --minimal --datadir /data
L1_SNAPSHOT_DIR=./data/chiado-l1-2
L2_DATA_DIR=./data/eez-l2-2
JWT_FILE=./data/jwt-2.hex          # own: openssl rand -hex 32 > ./data/jwt-2.hex
LIGHTHOUSE_DATA=./data/chiado-lighthouse-2
# SHARED with the 1st — the genesis ROOT must match the on-chain registration.
# Do NOT regenerate; this is the exact file the deploy wrote.
FRESH_GENESIS=./datadir/genesis.json
CHIADO_CONFIG_DIR=./configs/chiado
# 2nd L1 engine-API port (the -2 override + lighthouse follow this).
L1_AUTH_PORT=18651

# ── Topology ─────────────────────────────────────────────────────────
# 1 = own embedded chiado L1 → can COMPETE on cross-chain slots (the EvmComposer
#     is gated on the embedded L1). REQUIRED for a real competitor on this
#     cross-chain rollup. ~18-24GB.
# 0 = share the 1st's L1 (set EEZ_L1_RPC_URL=http://127.0.0.1:18645 + drop the
#     lighthouse service + EEZ_L1_INTERCEPTOR_PORT=''); yields an L2-ONLY / backup
#     poster with NO cross-chain composing. ~6-8GB.
EEZ_L1_EMBEDDED=1

# ── Keys / relay ─────────────────────────────────────────────────────
# DISTINCT, funded chiado EOA — two composers on one poster collide on L1 nonces.
EEZ_L1_POSTER_KEY=0xCHANGE_ME_SECOND_POSTER
# SHARED — the SAME registered authorizedSigner as the 1st (the PS has ONE).
EEZ_PROOF_SIGNER_KEY=0xSAME_AS_FIRST
# L2 system signer (cross-chain inbound) — same default as the 1st.
EEZ_L2_SYSTEM_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
EEZ_L2_SYSTEM_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
# SAME relay — both race into the same L1 slots; StateRootMismatch picks the winner.
EEZ_L1_BUILDER_RPC_URL=https://builder.chiado.gcd.ovh/
