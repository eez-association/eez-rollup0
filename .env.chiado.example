# Copy to .env.chiado, fill in, then run:
#   docker compose --env-file .env.chiado -f docker-compose.chiado-node.yml up
#
# This single file feeds both compose variable-substitution (the host
# paths below) and the eez-node container env (the secrets below). The
# protocol addresses come separately from deployments.env (written by the
# one-time `make deploy-protocol`).

# ── Host paths (compose volume substitution) ─────────────────────────
# Chiado L1 snapshot — populate ONCE before first `up`:
#   docker run --rm -v "$PWD/data/chiado-l1:/data" \
#     ghcr.io/gnosischain/reth_gnosis:v2.0.0 \
#     download --chain chiado --minimal --datadir /data
L1_SNAPSHOT_DIR=./data/chiado-l1
L2_DATA_DIR=./data/eez-l2
# L2 genesis (deploy-aligned timestamp). WRITTEN BY `make deploy-protocol`
# at ./datadir/genesis.json — do NOT hand-create it; just keep this default
# and run the deploy first.
FRESH_GENESIS=./datadir/genesis.json
# Shared engine-API JWT — create once: openssl rand -hex 32 > ./data/jwt.hex
JWT_FILE=./data/jwt.hex
LIGHTHOUSE_DATA=./data/chiado-lighthouse
# Chiado testnet config dir (config.yaml, bootnodes, deploy_block.txt).
CHIADO_CONFIG_DIR=./configs/chiado
# Embedded-L1 engine-API port. Default 18551; override if the host already
# runs a reth on 18551 (e.g. a standalone chiado-reth used for deploys).
# L1_AUTH_PORT=18661

# ── Secrets / config (passed into the eez-node container) ────────────
# Funded chiado keys — get xDAI from a faucet (https://faucet.chiadochain.net).
# Bundle poster (pays L1 gas for postBatch); keep separate from the proof signer.
# PER-MACHINE: each competing composer needs its OWN funded poster EOA (sharing
# one would collide on L1 nonces). See docs/competing-composer.md.
EEZ_L1_POSTER_KEY=0xCHANGE_ME
# Proof signer — MUST equal the proof system's registered authorizedSigner set at
# deploy time (the EEZ_PROOF_SIGNER_KEY used for the deploy). Dev mock PS: the
# MockECDSAProofSystem.authorizedSigner. Driven/deferred-post stack
# (EEZ_PROOF_SYSTEM=real + docker-compose.driven.override.yml): the real
# ECDSAProofSystem.authorizedSigner. SHARED across competing composers (each
# node's attester == the prover's signer == this one registered key).
EEZ_PROOF_SIGNER_KEY=0xCHANGE_ME
# ALTERNATIVE (split-prover topology, deferred-post only): give the node just
# the registered attester ADDRESS and keep the private key solely on the
# remote eez-proverd machine (docker-compose.remote-prover.override.yml +
# docker-compose.proverd.remote.yml). Query it from the deployed PS:
#   cast call <EEZ_PROOF_SYSTEM_ADDRESS> "signer()(address)" --rpc-url <chiado RPC>
# Set EXACTLY ONE of KEY/ADDRESS (if both, they must match; the key wins).
# The colocated docker-compose.driven.override.yml needs the KEY (its
# eez-proverd signs with it) — address-only pairs with the remote files.
# EEZ_PROOF_SIGNER_ADDRESS=0xCHANGE_ME
# L2 system signer (cross-chain inbound). Default = hardhat key 0, funded in genesis.
EEZ_L2_SYSTEM_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
EEZ_L2_SYSTEM_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
# Chiado bundle relay (rbuilder).
EEZ_L1_BUILDER_RPC_URL=https://builder.chiado.gcd.ovh/
