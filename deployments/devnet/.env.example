# Local-only devnet configuration for deployments/devnet.
# Copy this file to .env in this directory before running docker compose.

EEZ_L1_RPC_URL=http://l1:8545
# Local devnet builder shim accepts eth_sendBundle and forwards to L1.
EEZ_L1_BUILDER_RPC_URL=http://builder:8545

# reth/anvil dev account #0. Public devnet key only.
EEZ_L1_POSTER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Stage 2 mock proof signer. For this local devnet it can match the poster.
EEZ_PROOF_SIGNER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Matches the reth dev-style L2 genesis template in this deployment.
EEZ_INITIAL_STATE_ROOT=0xf09d8f7da5bc5036f8dd9536c953e2212390a46fb3e553ece2b7d419131537b1

# Keep blank for local devnet; Blockscout is not part of this first setup.
EEZ_BLOCKSCOUT_URL=

# Composer posts at most one batch per tick.
EEZ_COMPOSER_INTERVAL_SECS=60
