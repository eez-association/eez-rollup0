# Local-only multi-sequencer devnet configuration.
# Copy this file to .env in this directory before running docker compose.

EEZ_L1_RPC_URL=http://l1:8545

# Used by the one-shot deploy service. Individual sequencers override the
# L1 poster key in docker-compose.yml so they do not share an L1 nonce.
EEZ_L1_POSTER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Stage 2 mock proof signer. All sequencers share this because the mock proof
# system authorizes one signer at deploy time.
EEZ_PROOF_SIGNER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Matches the reth dev-style L2 genesis template.
EEZ_INITIAL_STATE_ROOT=0xf09d8f7da5bc5036f8dd9536c953e2212390a46fb3e553ece2b7d419131537b1

# Keep blank for local devnet; Blockscout is not part of this setup.
EEZ_BLOCKSCOUT_URL=

# The multi-sequencer compose file overrides intervals per node to stagger
# batch posting. This value is the fallback.
EEZ_COMPOSER_INTERVAL_SECS=60

# External batches are expected when multiple sequencers post for one rollup.
EEZ_COMPOSER_EXPECT_EXTERNAL_BATCHES=true
