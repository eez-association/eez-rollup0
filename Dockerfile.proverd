# syntax=docker/dockerfile:1
#
# eez-proverd image. Builds TWO binaries from source, both plain cargo
# (NO ZisK toolchain — the ZK guest is not needed for the mock proof
# system; the prover does NATIVE re-execution via `native-validate` and
# signs the attestation with EEZ_PROOF_SIGNER_KEY):
#
#   1. eez-proverd     — from this workspace (crates/), cargo-chef cached.
#   2. native-validate — from OUR fork of zisk-eth-client
#                        (eez-association/zisk-eth-client @ the pinned
#                        commit below — NOT upstream 0xPolygonHermez,
#                        which lacks native-validate + eez-public-inputs).
#
# Pin the fork commit; bump it deliberately and keep it in lockstep with
# the protocol submodule (the guest + native-validate share the EEZ
# batch-content commitment).

# ── chef base: toolchain + system deps reth/mdbx/secp256k1 need ───────
FROM rust:1.94-bookworm AS chef
RUN apt-get update && apt-get install -y --no-install-recommends \
        clang libclang-dev pkg-config cmake libssl-dev git ca-certificates \
        protobuf-compiler mold \
    && rm -rf /var/lib/apt/lists/* \
    && cargo install cargo-chef --locked
# mold for fast final links; same flags for cook and build (fingerprint
# consistency) — see the matching comment in Dockerfile.
ENV RUSTFLAGS="-C link-arg=-fuse-ld=mold"
WORKDIR /build

# ── planner: dependency recipe from this workspace's manifests ────────
FROM chef AS planner
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN cargo chef prepare --recipe-path recipe.json

# ── builder: cook deps (cached), then build eez-proverd ──────────────
# Cache-mount setup mirrors Dockerfile (see the comment there): same
# mounts on cook and build, registry/git subdirs only, binary cp'd out
# of the mount. Target id is per-image — eez-proverd resolves different
# dep feature sets than eez-node, and a shared target would thrash.
FROM chef AS builder
COPY --from=planner /build/recipe.json recipe.json
# Cook with the SAME package selection as the build below: resolver=2
# feature-unifies per selected package, so a plain workspace cook produces
# ~80 dep variants eez-proverd never uses while missing the ones it does —
# those deps silently recompiled in the source layer on every code change.
RUN --mount=type=cache,id=cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=cargo-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=eez-proverd-target,target=/build/target,sharing=locked \
    cargo chef cook --release -p eez-proverd --recipe-path recipe.json
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN --mount=type=cache,id=cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=cargo-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=eez-proverd-target,target=/build/target,sharing=locked \
    cargo build --release -p eez-proverd \
    && cp target/release/eez-proverd /build/eez-proverd

# ── validator: native-validate from OUR zisk-eth-client fork ─────────
FROM rust:1.94-bookworm AS validator
RUN apt-get update && apt-get install -y --no-install-recommends \
        clang libclang-dev pkg-config cmake libssl-dev git ca-certificates nasm \
    && rm -rf /var/lib/apt/lists/*
# OUR fork + the exact commit that carries native-validate + the EEZ
# public-inputs commitment (guest parity). NOT on upstream.
ARG ZISK_FORK_URL=https://github.com/eez-association/zisk-eth-client.git
ARG ZISK_COMMIT=a2dd9ac41012e5991d5938bf096c0fd2885ab1e0
# The fork's `[patch."…/stateless.git"]` points `stateless`/`tries` at a SIBLING
# checkout (`../zisk-patch-stateless`), so clone that repo NEXT TO the fork (the
# fork lands in /v, so the sibling resolves to /zisk-patch-stateless). OUR fork
# of zisk-patch-stateless: the pinned commit carries pair-roots stateless
# validation plus the EIP-2935 empty-block fix. Without that fix, native-validate
# falls back to parent.state_root for empty Prague blocks and rejects live L2
# blocks whose only state transition is the recent-blockhash system write.
ARG ZISK_PATCH_URL=https://github.com/eez-association/zisk-patch-stateless.git
ARG ZISK_PATCH_BRANCH=eez-revm38
ARG ZISK_PATCH_COMMIT=14fa34607d2ae2a9ce7edb3f0d1a50bc7ea8c474
RUN git clone --branch "$ZISK_PATCH_BRANCH" "$ZISK_PATCH_URL" /zisk-patch-stateless \
    && git -C /zisk-patch-stateless checkout "$ZISK_PATCH_COMMIT"
WORKDIR /v
RUN git clone "$ZISK_FORK_URL" . \
    && git checkout "$ZISK_COMMIT" \
    && cargo build --release --bin native-validate \
    && strip target/release/native-validate

# ── chaincfg: derive the validator ChainConfig from the canonical genesis ──
# native-validate wants a bare alloy `ChainConfig` (genesis.json's `.config`
# field), NOT the full genesis: ChainConfig is #[serde(default)] with no
# deny_unknown_fields, so the full file would silently parse as chainId 0
# with every fork off. Extract at build time so genesis.json stays the
# single source of truth. Separate stage on purpose: adding jq to the chef
# apt layer would bust both images' cooked-dependency caches.
FROM debian:bookworm-slim AS chaincfg
RUN apt-get update && apt-get install -y --no-install-recommends jq \
    && rm -rf /var/lib/apt/lists/*
COPY genesis.json /genesis.json
RUN jq -e .config /genesis.json > /l2-chainconfig.json

# ── runtime: slim image with both binaries + the L2 chain-config ─────
FROM debian:bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder   /build/eez-proverd                    /usr/local/bin/eez-proverd
COPY --from=validator /v/target/release/native-validate     /usr/local/bin/native-validate
# L2 chain-config (alloy ChainConfig; all forks at 0 for the eez-dev chain).
COPY --from=chaincfg /l2-chainconfig.json /app/l2-chainconfig.json
ENTRYPOINT ["eez-proverd"]
CMD ["--help"]
