#!/usr/bin/env bash
# Route the one broken 5c51e02 L2-table verifier to the corrected parent-repo
# compatibility verifier. All compilation, deployment, and other verification
# commands continue to use the real forge binary unchanged.
set -euo pipefail

REAL_FORGE="${EEZ_REAL_FORGE:?EEZ_REAL_FORGE must point to the real forge binary}"
args=("$@")

if [[ "${1:-}" == "script" ]]; then
    for ((i = 0; i < ${#args[@]}; i++)); do
        if [[ "${args[$i]}" == "script/e2e/shared/Verify.s.sol:VerifyL2Blocks" ]]; then
            args[$i]="${EEZ_PROTOCOL_VERIFY_FILE:?}:VerifyL2Blocks5c"
            break
        fi
    done
fi

exec "$REAL_FORGE" "${args[@]}"
