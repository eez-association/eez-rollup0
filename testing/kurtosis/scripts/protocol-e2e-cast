#!/usr/bin/env bash
# Route protocol user submissions through the cross-chain fronts.
# Keep reads, deployments, and receipt queries on the canonical RPCs.
set -euo pipefail

REAL_CAST="${EEZ_REAL_CAST:?EEZ_REAL_CAST must point to the real cast binary}"

if [[ "${1:-}" == "rpc" && "${2:-}" == "eth_sendRawTransaction" ]]; then
    args=("$@")
    for ((i = 0; i < ${#args[@]}; i++)); do
        if [[ "${args[$i]}" == "--rpc-url" && $((i + 1)) -lt ${#args[@]} ]]; then
            case "${args[$((i + 1))]}" in
                "$EEZ_PROTOCOL_L1_RPC") args[$((i + 1))]="$EEZ_PROTOCOL_L1_FRONT" ;;
                "$EEZ_PROTOCOL_L2_RPC") args[$((i + 1))]="$EEZ_PROTOCOL_L2_FRONT" ;;
            esac
            break
        fi
    done
    exec "$REAL_CAST" "${args[@]}"
fi

# Fronts hold user transactions until the composer includes their bundle.
# Poll the canonical RPC because the upstream runner checks immediately.
if [[ "${1:-}" == "receipt" ]]; then
    deadline=$((SECONDS + ${EEZ_PROTOCOL_RECEIPT_TIMEOUT_SECS:-420}))
    while ((SECONDS < deadline)); do
        if output=$("$REAL_CAST" "$@" 2>/dev/null); then
            printf '%s\n' "$output"
            exit 0
        fi
        sleep 2
    done
    echo "ERROR: no receipt after ${EEZ_PROTOCOL_RECEIPT_TIMEOUT_SECS:-420}s" >&2
    exit 1
fi

exec "$REAL_CAST" "$@"
