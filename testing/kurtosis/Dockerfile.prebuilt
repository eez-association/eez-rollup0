# syntax=docker/dockerfile:1
# Thin CI images built from binaries produced by the shared build-e2e job.

FROM ubuntu:24.04 AS node
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --chmod=0555 eez-composer /usr/local/bin/eez-composer
COPY --chmod=0555 eez-follower /usr/local/bin/eez-follower
COPY --chmod=0555 eez-genesis-state-root /usr/local/bin/eez-genesis-state-root
COPY --chmod=0555 eez-genesis-block-hash /usr/local/bin/eez-genesis-block-hash
ENTRYPOINT ["eez-composer"]
CMD ["--help"]

FROM ubuntu:24.04 AS proof-signer
RUN apt-get update && apt-get install -y --no-install-recommends \
        netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*
COPY --chmod=0555 eez-proof-signer /usr/local/bin/eez-proof-signer
WORKDIR /app
USER 65532:65532
EXPOSE 50061/tcp
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/eez-proof-signer"]
