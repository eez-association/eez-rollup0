# eez-l1-12s enclave endpoints (host-side), as forwarded onto FIXED ports by
# `testing/kurtosis/scripts/12s-l1-up.sh` step [4/7]. Valid only while that
# script's socat forwarders are running.
#
# Talking to the enclave directly instead? Kurtosis assigns a fresh random host
# port per instance — re-resolve with:
#   kurtosis port print eez-l1-12s <service> <port-id>
#
# Topology: 1 validator pair (el-1) + 1 builder pair (el-2-reth-builder).
EEZ_L1_RPC_URL=http://127.0.0.1:8545
EEZ_L1_BUILDER_RPC_URL=http://127.0.0.1:8645
EEZ_L1_BEACON_URL=http://127.0.0.1:5052
EEZ_L1_DORA_URL=http://127.0.0.1:8080
